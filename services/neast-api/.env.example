APP_NAME=skeleton
APP_ENV=dev
APP_URL=https://api.neast.my

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gljy-shop
DB_USERNAME=root
DB_PASSWORD=12345678
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

REDIS_HOST=127.0.0.1
REDIS_AUTH=(null)
REDIS_PORT=6379
REDIS_DB=5
REDIS_PREFIX=suzan_

# Fiuu H5 支付（MOLPay Seamless）
FIUU_MERCHANT_ID=
FIUU_VERIFY_KEY=
FIUU_SECRET_KEY=
FIUU_CURRENCY=MYR
FIUU_COUNTRY=MY

# H5 支付页域名（可与 API 域名不同；留空则同 APP_URL）
PAYMENT_H5_BASE_URL=

# 推荐邀请链接（指向本 API 的 H5 落地页）
REFERR_INVITE_URL=http://localhost:9512/invite

# 商家分享链接前缀（App 分享时使用，末尾不带 /）
MERCHANT_SHARE_BASE_URL=http://localhost:9512/merchant

# App 商店链接（未上架先留空）
APP_STORE_URL=
GOOGLE_PLAY_URL=

# 房东端 App 商店链接
OWNER_APP_STORE_URL=
OWNER_GOOGLE_PLAY_URL=

# 商家端 App 商店链接
MERCHANT_APP_STORE_URL=
MERCHANT_GOOGLE_PLAY_URL=

# Firebase Cloud Messaging 服务账号凭证（相对项目根目录）
FIREBASE_CREDENTIALS=storage/firebase-credentials.json

# Alpha 提示开关（各端独立）
SHOW_ALPHA_NOTICE_USER=false
SHOW_ALPHA_NOTICE_MERCHANT=false
SHOW_ALPHA_NOTICE_LANDLORD=false