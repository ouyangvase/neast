{
  "expo": {
    "name": "NEAST Owner",
    "slug": "neast-owner",
    "version": "1.0.6",
    "orientation": "portrait",
    "scheme": "neastowner",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon/app_icon.png",
    "ios": {
      "bundleIdentifier": "com.neastLandlords.flutter",
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.neastLandlords.flutter",
      "googleServicesFile": "./google-services.json",
      "permissions": ["CAMERA"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [{ "scheme": "neastowner" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/launch_android.png",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 220,
          "ios": {
            "image": "./assets/images/launch_ios.png",
            "backgroundColor": "#0D2958"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0851AA"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow NEAST Owner to access your camera to take property and bank photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow NEAST Owner to access your photos to upload property and bank images."
        }
      ]
    ],
    "extra": {
      "router": {}
    }
  }
}
