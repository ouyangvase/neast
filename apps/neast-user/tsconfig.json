{
  "extends": [
    "../../tsconfig.base.json",
    "expo/tsconfig.base"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@assets/*": ["assets/*"],
      "@ui/*": ["../ui/mobile/src/*"],
      "@ui-assets/*": ["../ui/mobile/assets/*"]
    }
  },
  "include": [
    "app",
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".expo"
  ]
}
