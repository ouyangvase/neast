{
  "expo": {
    "name": "NEAST",
    "slug": "neast-user",
    "version": "1.0.13",
    "orientation": "portrait",
    "scheme": "neastuser",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon/app_icon.png",
    "ios": {
      "bundleIdentifier": "com.neastusers.flutter",
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.neastusers.flutter",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "neastuser"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "https",
              "host": "api.neast.my",
              "pathPrefix": "/merchant/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/launch_android.png",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 220,
          "ios": {
            "image": "./assets/images/launch_ios.png",
            "backgroundColor": "#4A78BD"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0851AA"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow NEAST to access your camera to scan QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow NEAST to access your photos to upload tenancy agreements."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow NEAST to access your photos.",
          "savePhotosPermission": "Allow NEAST to save images to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow NEAST to use your location to show nearby merchants and deals."
        }
      ],
      "expo-sharing",
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7a94e8c0-cb62-43ab-85c2-befcdf870d2b"
      }
    },
    "owner": "whanx422"
  }
}
