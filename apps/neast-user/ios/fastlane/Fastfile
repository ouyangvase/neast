default_platform(:ios)

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV["ASC_API_KEY_ID"],
    issuer_id: ENV["ASC_API_KEY_ISSUER_ID"],
    key_content: ENV["ASC_API_KEY_P8"],
    is_key_content_base64: false,
    in_house: false
  )
end

platform :ios do
  desc "CI keychain + match signing assets"
  private_lane :prepare_signing do
    setup_ci
    match(
      type: "appstore",
      readonly: true,
      api_key: asc_api_key,
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"]
    )
  end

  desc "Archive and export IPA with the match profile"
  private_lane :build_ipa do
    bundle_id = ENV["IOS_BUNDLE_ID"]
    team = ENV["ASC_TEAM_ID"]
    profile = "match AppStore #{bundle_id}"
    build_app(
      scheme: "Runner",
      workspace: "Runner.xcworkspace",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "DEVELOPMENT_TEAM='#{team}' CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER='#{profile}'",
      export_options: {
        signingStyle: "manual",
        teamID: team,
        provisioningProfiles: { bundle_id => profile }
      },
      output_directory: "build/ios/ipa",
      output_name: "Runner.ipa"
    )
  end

  desc "Build IPA and upload to TestFlight"
  lane :beta do
    prepare_signing
    build_ipa
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: "build/ios/ipa/Runner.ipa",
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build IPA and upload to App Store Connect (no review submission)"
  lane :build_upload do
    beta
  end

  desc "Submit the latest uploaded build for App Store review"
  lane :submit_review do
    api_key = asc_api_key
    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: ENV["IOS_BUNDLE_ID"]
    )
    deliver(
      api_key: api_key,
      app_version: ENV["APP_VERSION"],
      build_number: build_number.to_s,
      submit_for_review: true,
      automatic_release: ENV["AUTOMATIC_RELEASE"] == "true",
      release_notes: { "en-US" => ENV["RELEASE_NOTES"] },
      skip_binary_upload: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      force: true
    )
  end
end
